# AIfred config. Copy to .env, fill values. .env is gitignored (V8/C5).
# Secrets live here only — never in code, spec, or logs. Every channel is
# optional; with only brain.md set, AIfred runs as a notes-and-chat assistant.

# --- model (I.model, C1) ---
AIFRED_OLLAMA_BASE_URL=http://localhost:11434/v1
AIFRED_MODEL=qwen3.6:27b
AIFRED_CTX_BUDGET=16384
# cloud fallback opt-in only (V1, C6). Leave blank to keep fully local.
AIFRED_CLOUD_FALLBACK_ENABLED=false
OPENROUTER_API_KEY=
# sampling (tuned by aifred/eval). num_ctx must match the model's loaded window
# (also set OLLAMA_CONTEXT_LENGTH=16384 on the ollama service).
AIFRED_NUM_CTX=16384
AIFRED_TEMPERATURE=0.0

# --- vision (on demand) + in-engine memory (RAG) ---
# vision model loads only when an image needs reading; embedder stays resident
# next to the chat model — set OLLAMA_MAX_LOADED_MODELS=2 on the ollama service.
AIFRED_VISION_ENABLED=true
AIFRED_VISION_MODEL=qwen3-vl:8b-instruct-q8_0
AIFRED_RAG_ENABLED=true
AIFRED_EMBED_MODEL=qwen3-embedding:0.6b

# --- brain.md MCP (I.brainmd) — required ---
AIFRED_BRAINMD_MCP_URL=
MCP_BRAIN_MD_API_KEY=
# human base URL for note context links (best-effort; defaults from the MCP URL)
AIFRED_BRAINMD_WEB_URL=

# --- google (I.gmail, I.calendar, I.drive) ---
# scopes: gmail.readonly + calendar + drive.readonly + contacts.readonly
AIFRED_GOOGLE_TOKEN_PATH=
AIFRED_GOOGLE_CLIENT_SECRET_PATH=
AIFRED_OWNER_EMAIL=

# --- telegram (I.telegram) — push channel + chat ---
AIFRED_TELEGRAM_BOT_TOKEN=
AIFRED_TELEGRAM_ALLOWED_USERS=
AIFRED_TELEGRAM_HOME_CHANNEL=

# --- whatsapp (I.whatsapp) — neonize/whatsmeow; pair from the web UI ---
AIFRED_WHATSAPP_ENABLED=false
AIFRED_WHATSAPP_SESSION=
# your own WhatsApp identity, so AIfred ignores your own messages and accepts
# your commands ("Alfredzie, ..."). lid = the @lid id WhatsApp assigns you.
AIFRED_OWNER_WHATSAPP=
AIFRED_OWNER_WHATSAPP_LID=
# names other people use for you (comma-separated)
AIFRED_OWNER_ALIASES=

# --- autonomy (self-maintenance) ---
AIFRED_CONTACTS_WRITEBACK=true
AIFRED_DAILY_NOTE=true
AIFRED_DAILY_NOTE_HOUR=6

# --- store (I.store) ---
AIFRED_DATA_DIR=./data

# --- web (I.web) ---
AIFRED_WEB_HOST=127.0.0.1
AIFRED_WEB_PORT=9120
# if set, required as X-AIfred-Token on /api/*
AIFRED_WEB_TOKEN=
